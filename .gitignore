# Ambiente virtual Python (não deve ser versionado)
.venv/
.venv-1/
.venv*/

# Cache de bytecode do Python
__pycache__/
*.pyc

# Backups gerados durante a refatoração
*.bak

# Pastas de processo geradas pela automação (PDFs/JPGs com dados reais
# de processos do SEI/SIGEF - não devem ir para o controle de versão).
# Padrão genérico (ex: "0029.001924-2026-52") em vez de uma pasta fixa,
# pra cobrir qualquer processo novo automaticamente.
[0-9][0-9][0-9][0-9].[0-9]*-[0-9][0-9][0-9][0-9]-[0-9]*/

gags/

# Últimos valores digitados (processo, dados do SEI, CE, NL...), salvos
# automaticamente pra facilitar testes isolados de cada etapa. Contém
# dados reais (CNPJ, valores etc.) - não deve ir para o controle de versão.
sessao_atual.json